#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;

typedef struct {
    Node *top;
} ListStack;

void init_stack(ListStack *s) {
    s->top = NULL;
}

int is_empty(ListStack *s) {
    return s->top == NULL;
}

int is_full(ListStack *s) {
    return 0;
}

void push(ListStack *s, int val) {
    Node *new_node = (Node *)malloc(sizeof(Node));
    if (!new_node) return;
    new_node->data = val;
    new_node->next = s->top;
    s->top = new_node;
}

int pop(ListStack *s, int *error) {
    if (is_empty(s)) {
        *error = 1;
        return 0;
    }
    *error = 0;
    Node *temp = s->top;
    int val = temp->data;
    s->top = temp->next;
    free(temp);
    return val;
}

int peek(ListStack *s, int *error) {
    if (is_empty(s)) {
        *error = 1;
        return 0;
    }
    *error = 0;
    return s->top->data;
}

void free_stack(ListStack *s) {
    int err;
    while (!is_empty(s)) {
        pop(s, &err);
    }
}

int evaluate_postfix(const char *expr) {
    ListStack s;
    init_stack(&s);
    int err = 0;

    for (int i = 0; expr[i] != '\0'; i++) {
        if (expr[i] == ' ') continue;

        if (isdigit(expr[i])) {
            push(&s, expr[i] - '0');
        } else if (expr[i] == '+' || expr[i] == '-' || expr[i] == '*' || expr[i] == '/') {
            int val2 = pop(&s, &err);
            if (err) { free_stack(&s); return -9999; }
            int val1 = pop(&s, &err);
            if (err) { free_stack(&s); return -9999; }

            switch (expr[i]) {
                case '+': push(&s, val1 + val2); break;
                case '-': push(&s, val1 - val2); break;
                case '*': push(&s, val1 * val2); break;
                case '/': push(&s, val1 / val2); break;
            }
        }
    }

    int result = pop(&s, &err);
    if (!is_empty(&s)) {
        free_stack(&s);
        return -9999;
    }
    return result;
}

int main() {
    const char *expr1 = "5 3 - 2 *";
    printf("%d\n", evaluate_postfix(expr1));

